{
  "profileId": "oauth2_client_credentials",
  "level": "L1",
  "displayName": "OAuth2 Client Credentials",
  "description": "标准 client_credentials 换 token",
  "credentialSlots": [
    { "ref": "appId", "label": "Client ID", "required": true, "masked": false },
    { "ref": "appSecret", "label": "Client Secret", "required": true, "masked": true }
  ],
  "paramSchema": {
    "type": "object",
    "required": ["tokenUrl"],
    "properties": {
      "tokenUrl": { "type": "string", "title": "Token 地址", "description": "相对 baseUrl 或绝对 URL" },
      "scope": { "type": "string", "title": "Scope" },
      "headerName": { "type": "string", "default": "Authorization", "title": "Token 请求头" },
      "cacheTtlSeconds": { "type": "integer", "default": 3600, "minimum": 60, "title": "缓存秒数" }
    }
  },
  "specFragmentExample": {
    "type": "oauth2_client_credentials",
    "tokenUrl": "/oauth/token",
    "scope": "openid",
    "headerName": "Authorization"
  }
}
